@*
    Routing root. Photino.Blazor sets up a WebViewManager, so the ordinary Blazor Router works
    here exactly as it does on the web - pages carry @page, navigation goes through
    NavigationManager, and no page reload ever happens.
*@
@inject StartupOptions Startup
@inject IDiskOpenService Opener
@inject DiskSession Session
@inject NavigationManager Navigation
@inject ILogger<App> Logger

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="alert alert-warning" role="alert">
                Nie ma takiej strony.
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // A path on the command line opens straight away. Done after the first render rather than in
    // OnInitialized, because navigating before the Router has rendered once goes nowhere.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Startup.Path is not { Length: > 0 } path || Session.HasDisk)
        {
            return;
        }

        try
        {
            Session.Open(await Opener.OpenPathAsync(path));
            Navigation.NavigateTo("disk");
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Could not open {Path} given on the command line", path);
        }
    }
}
