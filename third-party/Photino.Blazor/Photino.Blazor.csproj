<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Vendored fork of Photino.Blazor - see NOTICE.md for provenance and the list of changes.
        Kept as source (rather than the NuGet package) so the Blazor host can be stepped into
        and patched when Photino misbehaves.

        Upstream targets net8.0;net9.0 and pins the Microsoft components to 8.0.x / 9.0.x.
        Here it is a single net10.0 target on the 10.0.x components, matching the rest of
        the solution. Photino.NET 4.0.16 is upstream's own latest and already pulls the
        current native layer (Photino.Native 4.0.22), so it stays as is.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>

        <!--
            Upstream sets neither, and its source is not nullable-clean. Turning either on here
            would mean editing vendored files for no functional gain and more merge pain later.
        -->
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <Authors>TryPhotino</Authors>
        <Company>TryPhotino</Company>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/tryphotino/photino.Blazor</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LICENSE" />
        <None Include="NOTICE.md" />
        <None Include="README.upstream.md" />
    </ItemGroup>

</Project>
